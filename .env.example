# Copy to .env.local and fill in. Never commit .env.local.

# Where this app is served from. Sign-in returns here, so it must match an
# address registered on the Cognito app client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (dev: https://api-dev.ambrace.in, local backend: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=https://api-dev.ambrace.in

# Sign-in (Amazon Cognito). Public identifiers, not secrets. The values come
# from the backend deploy outputs: cognito_user_pool_id, cognito_app_client_id
# and cognito_domain_url (without "https://").
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# PostHog. Analytics stay off unless both are set: a project key (phc_...)
# and the address events go to. See docs/analytics.md for what is sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shows the voice diagnostics panel outside development when "true".
NEXT_PUBLIC_VOICE_DIAGNOSTICS=false
